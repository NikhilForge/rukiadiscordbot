# Copy this file to ".env" and fill it in. NEVER share or commit your real .env.

# --- Discord (required) -----------------------------------------------------
DISCORD_TOKEN=

# --- AI providers (set at least ONE; a provider is active only if its key is set)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Web search (optional; set Tavily or Brave to turn search on) -----------
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Persistent memory (optional) -------------------------------------------
# Supabase "Session pooler" connection string. Leave empty to use local rukia.db
DATABASE_URL=

# --- Optional model overrides (defaults are used when empty) ----------------
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
GROQ_VISION_MODEL=
